# CyberTown backend environment example
#
# Copy this file to `.env` in the same directory, then fill in your real
# third-party OpenAI-compatible gateway values. Do not commit real secrets.

# ================================
# LLM gateway
# ================================
# Recommended canonical variables used by hello-agents:
LLM_API_KEY=
LLM_BASE_URL=https://elysiver.h-e.top/v1
LLM_MODEL_ID=glm-5.3-flash

# Examples:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_ID=deepseek-chat
#
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_ID=qwen-plus
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_ID=gpt-4o-mini

# Common aliases are also accepted by backend/config.py:
# OPENAI_API_KEY=your-gateway-api-key
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# OPENAI_MODEL=your-model-name
# LLM_MODEL=your-model-name

# Optional request timeout in seconds:
LLM_TIMEOUT=60
LLM_MAX_RETRIES=0
LLM_AFFINITY_ENABLED=true
# 好感度分析使用独立LLM(deepseek-v4-flash)。
# 注意: 不要复用主对话的思考型模型(glm-5.3-flash)——
# 它在 max_tokens 很小时把预算全花在 reasoning_content 上,导致 content 为空,
# 使好感度 JSON 解析一直失败。
LLM_AFFINITY_API_KEY=
LLM_AFFINITY_BASE_URL=https://wzw.pp.ua/v1
LLM_AFFINITY_MODEL_ID=deepseek-v4-flash
LLM_AFFINITY_TIMEOUT=8
LLM_AFFINITY_MAX_RETRIES=0
LLM_AFFINITY_FALLBACK_TO_MAIN=true

# ================================
# Backend server
# ================================
API_HOST=127.0.0.1
API_PORT=8000
NPC_UPDATE_INTERVAL=30

# ================================
# Memory and vector search
# ================================
# Local Qdrant has already been verified with:
# docker start ai-town-qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ai_town_local
QDRANT_DISTANCE=cosine

# Use local sentence-transformers embedding model.
EMBED_MODEL_TYPE=local
# Default local model when omitted:
# EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
